# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_STARTER=price_xxx_starter
STRIPE_PRICE_PROFESSIONAL=price_xxx_professional
STRIPE_PRICE_PRAXIS_PLUS=price_xxx_praxis_plus

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Messaging-Anbieter: none | twilio_sms | twilio_whatsapp
MESSAGING_PROVIDER=none
# true = kein echter Versand (Testmodus)
MESSAGING_DRY_RUN=false

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+49...
TWILIO_WHATSAPP_FROM=+14155238886
# WhatsApp benötigt eine genehmigte Vorlage (Content SID); ohne diese wird nicht gesendet.
TWILIO_WHATSAPP_CONTENT_SID=

# Admin-Test-Telefonnummer für /admin/messaging-setup (Test-SMS)
ADMIN_TEST_PHONE=+49...

# Resend (E-Mail)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=SlotFill <onboarding@resend.dev>

# Admin-Zugang: kommagetrennte E-Mail-Adressen. Wer sich mit einer dieser
# Adressen registriert, hat automatisch Zugriff auf /admin.
ADMIN_EMAILS=transl.delta@gmail.com

# Cron
CRON_SECRET=your-cron-secret
