{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/trial-reminder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/reset-limits",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/auto-maintenance",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/operations-security-check",
      "schedule": "0 4 * * *"
    }
  ]
}
