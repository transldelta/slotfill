# .env.local.example – Clentra
# Kopiere diese Datei nach .env.local und befülle die Werte.
# Niemals echte Secrets in diese Datei eintragen oder committen.
# Für Vercel: Variablen unter Settings → Environment Variables anlegen.

# ── App-URL ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://clentra.de
# Lokal: NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://DEIN_PROJEKT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── E-Mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Produktion: verifizierte Domain clentra.de
RESEND_FROM_EMAIL=Clentra <noreply@clentra.de>

# ── Stripe (optional, nur wenn Checkout aktiv) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_PRAXIS_PLUS=price_...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=transl.delta@gmail.com

# ── Messaging (Standard: kein Versand) ───────────────────────────────────────
MESSAGING_PROVIDER=none
MESSAGING_DRY_RUN=true
# Twilio (nur wenn MESSAGING_PROVIDER=twilio_sms oder twilio_whatsapp)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_SMS_FROM=+49...
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=HX...

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=langes-geheimes-passwort

# ── Support/Kontakt (clentra.de-Adressen – nach Domain-E-Mail-Einrichtung setzen)
# SUPPORT_EMAIL=support@clentra.de
# CONTACT_EMAIL=kontakt@clentra.de
